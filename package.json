{
  "name": "music-explorer-js",
  "version": "2.0.0",
  "description": "Music Explorer: see which notes are playing in a clip of music.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode phone",
